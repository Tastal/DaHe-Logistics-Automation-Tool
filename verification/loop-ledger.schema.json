{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dahe:verification:loop-ledger:4",
  "title": "DaHe Loop Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "current_loop",
    "status",
    "run_id",
    "input_manifest",
    "gate_results",
    "unresolved_risks",
    "next_inputs",
    "last_accepted_git_commit",
    "waiver"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3,
        4
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "project_id": {
      "const": "DaHeLogistics"
    },
    "current_loop": {
      "type": "string",
      "pattern": "^loop-[0-9]+$"
    },
    "status": {
      "enum": [
        "in_progress",
        "accepted",
        "failed",
        "blocked",
        "closed_with_waiver",
        "shadow_accepted",
        "operational_read_only_with_guard",
        "operational_read_only_accepted",
        "operational_read_only_active"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest": {
      "$ref": "#/$defs/evidenceReference"
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_accepted_git_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "waiver": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_by",
            "accepted_at",
            "evidence",
            "permits_next_loop",
            "prohibited_claims",
            "reason"
          ],
          "properties": {
            "accepted_by": {
              "type": "string",
              "minLength": 1
            },
            "accepted_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            },
            "permits_next_loop": {
              "const": true
            },
            "prohibited_claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/shadowAcceptance"
        }
      ]
    },
    "operational_acceptance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/operationalAcceptance"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "required": [
            "acceptance"
          ]
        }
      },
      "else": {
        "required": [
          "acceptance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 4
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "operational_acceptance"
        ],
        "properties": {
          "acceptance": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "operational_acceptance"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "shadow_accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": 3
          },
          "current_loop": {
            "const": "loop-9"
          },
          "waiver": {
            "type": "null"
          },
          "acceptance": {
            "$ref": "#/$defs/shadowAcceptance"
          },
          "gate_results": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "schema_version": {
              "const": 3
            }
          },
          "required": [
            "schema_version"
          ]
        },
        "then": {
          "properties": {
            "acceptance": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "operational_read_only_with_guard",
              "operational_read_only_accepted",
              "operational_read_only_active"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": 4
          },
          "current_loop": {
            "const": "loop-9"
          },
          "waiver": {
            "type": "null"
          },
          "acceptance": {
            "type": "null"
          },
          "operational_acceptance": {
            "$ref": "#/$defs/operationalAcceptance"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "schema_version": {
              "const": 4
            }
          },
          "required": [
            "schema_version"
          ]
        },
        "then": {
          "properties": {
            "operational_acceptance": {
              "type": "null"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "shadowAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_at",
        "evidence",
        "kind",
        "previous_last_accepted_git_commit",
        "previous_status",
        "sha256"
      ],
      "properties": {
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "loop9_shadow_acceptance"
        },
        "previous_last_accepted_git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "previous_status": {
          "const": "in_progress"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "operationalAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_at",
        "build_git_commit",
        "evidence",
        "kind",
        "previous_status",
        "sha256",
        "status"
      ],
      "properties": {
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "build_git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "loop9_operational_read_only_acceptance",
            "loop9_operational_read_only_policy_change"
          ]
        },
        "previous_status": {
          "enum": [
            "in_progress",
            "operational_read_only_with_guard",
            "operational_read_only_accepted"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "operational_read_only_with_guard",
            "operational_read_only_accepted",
            "operational_read_only_active"
          ]
        }
      }
    }
  }
}
