{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dahe:ocr:result:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "command_id",
    "status",
    "worker_identity",
    "runtime_fingerprint",
    "verified_image_sha256",
    "elapsed_ms",
    "text_lines",
    "fields",
    "role_observation",
    "error"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "worker_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_image_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "text_lines": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/text_line"
      }
    },
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field_value"
      }
    },
    "role_observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/role_observation"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "normalized_box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "text_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "confidence",
        "box"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "box": {
          "$ref": "#/$defs/normalized_box"
        }
      }
    },
    "field_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "amount",
        "unit",
        "confidence"
      ],
      "properties": {
        "raw_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "role_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_text",
        "layout_fingerprint",
        "orientation_degrees"
      ],
      "properties": {
        "fixed_text": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "layout_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "orientation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "diagnostic_code"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "diagnostic_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          },
          "text_lines": {
            "maxItems": 0
          },
          "fields": {
            "maxProperties": 0
          },
          "role_observation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
