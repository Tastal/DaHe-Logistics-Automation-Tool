{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dahe.local/protocol/ocr/v2/command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "command_id",
    "operation",
    "images",
    "pipeline_fingerprint",
    "runtime_fingerprint",
    "profile_id"
  ],
  "properties": {
    "protocol_version": {"const": 2},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"const": "extract_batch"},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_sha256", "relative_path", "role"],
        "properties": {
          "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
          "role": {"enum": ["loading", "unloading"]}
        }
      }
    },
    "pipeline_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
